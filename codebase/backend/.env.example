# VLearn Multi-Agent Backend Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# 3 Distinct Models for 3 Agent Personas
# 1. Giảng viên (Strongest reasoning model):
MODEL_INSTRUCTOR=gemini-3.7-flash-high

# 2. Trợ giảng Socratic (Mid-tier fast reasoning model):
MODEL_TA=gemini-3.7-flash-medium

# 3. Bạn học Minh (Lightweight / Naive model with higher temperature):
MODEL_PEER=gemini-3.7-flash-low

# Server Config
HOST=0.0.0.0
PORT=8000
